{
  "name": "foc-dashboard",
  "version": "0.4.0",
  "description": "Static client-side dashboard for Filecoin Onchain Cloud datasets, pieces and Filecoin Pay balances.",
  "private": true,
  "license": "MIT",
  "author": "dgrafe",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgrafe/foc-dashboard.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check:notices": "node scripts/check-notices.mjs",
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "release": "npm test && npm run check:notices && npm run build"
  },
  "overrides": {
    "@filoz/synapse-core": {
      "zod": "4.6.7"
    }
  },
  "devDependencies": {
    "@filoz/synapse-core": "0.10.0",
    "@ipld/car": "5.4.7",
    "@ipld/dag-pb": "4.2.0",
    "@ipld/unixfs": "3.0.0",
    "@noble/hashes": "1.8.0",
    "esbuild": "0.28.2",
    "ipfs-unixfs": "11.2.5",
    "multiformats": "13.4.2",
    "viem": "2.57.11"
  }
}
